PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=noda
DB_USER=postgres
DB_PASSWORD=

# AI через omniroute (OpenAI-совместимый шлюз). Только на сервере, в клиент не попадает.
# Без ключа и модели остальное приложение работает, не работают вопросы и оценка ответов.
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
# По умолчанию http://localhost:20128/v1
OMNIROUTE_BASE_URL=
